# Copy the connection endpoint and credentials from the FalkorDB Cloud dashboard.
# Formats: falkor://<username>:<url-encoded-password>@<host>:<port>
#          redis://<username>:<url-encoded-password>@<host>:<port>
#          rediss://<username>:<url-encoded-password>@<host>:<port>
# Set TLS to true only if the dashboard says this instance endpoint uses TLS.
FALKORDB_URL=
FALKORDB_TLS=false
FALKORDB_GRAPH=mygraph
PORT=3001
